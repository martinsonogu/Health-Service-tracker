@page "{id:int}"
@model CommunityHealthServiceTracker.Pages.Referrals.DeleteModel

@{
    ViewData["Title"] = "Delete Referral";
}

<h1>Delete Referral</h1>

<p>
    Are you sure you want to delete this referral?
    This action cannot be undone.
</p>

<dl>
    <dt>Reference</dt>
    <dd>@Model.Referral.Reference</dd>

    <dt>Service</dt>
    <dd>@Model.Referral.ServiceName</dd>

    <dt>Status</dt>
    <dd>@Model.Referral.Status</dd>

    <dt>Priority</dt>
    <dd>@Model.Referral.Priority</dd>

    <dt>Referral Date</dt>
    <dd>@Model.Referral.ReferralDate.ToString("dd MMMM yyyy")</dd>

    <dt>Assigned Team</dt>
    <dd>@(Model.Referral.AssignedTeam ?? "Unassigned")</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Referral.Id" />

    <button type="submit">
        Delete referral
    </button>

    <a asp-page="./Details" asp-route-id="@Model.Referral.Id">
        Cancel
    </a>
</form>