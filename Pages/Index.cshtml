@page
@model IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<h1>Community Health Service Tracker</h1>

<p>
    Overview of fictional community health referrals and service activity.
</p>

<section class="dashboard-summary"
         aria-labelledby="referral-summary-heading">

    <h2 id="referral-summary-heading">
        Referral summary
    </h2>

    <div class="dashboard-grid">

        <div class="dashboard-card">
            <h3>Total referrals</h3>
            <p class="dashboard-card__number">
                @Model.TotalReferrals
            </p>
        </div>

        <div class="dashboard-card">
            <h3>New</h3>
            <p class="dashboard-card__number">
                @Model.NewReferrals
            </p>
        </div>

        <div class="dashboard-card">
            <h3>In progress</h3>
            <p class="dashboard-card__number">
                @Model.InProgressReferrals
            </p>
        </div>

        <div class="dashboard-card">
            <h3>Completed</h3>
            <p class="dashboard-card__number">
                @Model.CompletedReferrals
            </p>
        </div>

        <div class="dashboard-card">
            <h3>Urgent</h3>
            <p class="dashboard-card__number">
                @Model.UrgentReferrals
            </p>
        </div>

    </div>
</section>

<section aria-labelledby="recent-referrals-heading">

    <h2 id="recent-referrals-heading">
        Recent referrals
    </h2>

    @if (Model.RecentReferrals.Count == 0)
    {
        <p>No referrals have been recorded yet.</p>
    }
    else
    {
        <div class="referrals-table-wrapper"
         role="region"
         aria-label="Recent referrals table"
         tabindex="0">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Reference</th>
                        <th scope="col">Service</th>
                        <th scope="col">Status</th>
                        <th scope="col">Priority</th>
                        <th scope="col">Referral date</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var referral in Model.RecentReferrals)
                    {
                        <tr>
                            <td>
                                <a asp-page="/Referrals/Details"
                                asp-route-id="@referral.Id">
                                    @referral.Reference
                                </a>
                            </td>

                            <td>@referral.ServiceName</td>
                            <td>
                                @(referral.Status == ReferralStatus.InProgress
                                    ? "In Progress"
                                    : referral.Status.ToString())
                            </td>
                            <td>@referral.Priority</td>
                            <td>
                                @referral.ReferralDate.ToString("dd MMM yyyy")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <p class="view-all-referrals">
        <a asp-page="/Referrals/Index">
            View all referrals
        </a>
    </p>

</section>